-- โหลด Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- สร้าง Window เมนู
local Window = Rayfield:CreateWindow({
   Name = "Muscle Farming Menu",
   LoadingTitle = "Loading Hub...",
   LoadingSubtitle = "by Assistant",
   ConfigurationSaving = {
      Enabled = false,
   },
   Discord = {
      Enabled = false,
   },
   KeySystem = false
})

-- สร้าง Tab หลัก
local MainTab = Window:CreateTab("Main", 4483362458) -- Icon ID

-- ตัวแปรสถานะเปิด-ปิด Loop
local autoGain = false

-- สร้าง Toggle
local Toggle = MainTab:CreateToggle({
   Name = "Auto Gain Muscle",
   CurrentValue = false,
   Flag = "AutoGainMuscleFlag",
   Callback = function(Value)
      autoGain = Value
      
      -- Loop ส่ง RemoteEvent เมื่อกดเปิด Toggle
      if autoGain then
         task.spawn(function()
            while autoGain do
               local args = {
                  {
                     "GainMuscle"
                  }
               }
               game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvent"):FireServer(unpack(args))
               
               -- ระยะเวลาดีเลย์ระหว่างการส่ง Event (ปรับได้ตามต้องการ เช่น 0.1 หรือ 0.5)
               task.wait(0.1)
            end
         end)
      end
   end,
})
